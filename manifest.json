{
  "manifest_version": 3,
  "version": "1.19.0",
  "name": "LightTab - Minimal New Tab",
  "short_name": "LightTab",
  "description": "Minimal new tab: clock, lunar calendar, search, AI prompts, shortcuts, to-dos, Bing wallpapers. Local-first, optional cloud sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "bookmarks",
    "tabs"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://suggestion.baidu.com https://suggestqueries.google.com https://api.bing.com; object-src 'self';"
  },
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/chat*",
        "https://www.dola.com/chat*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "js/inject-ai.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}