{
  "manifest_version": 3,
  "version": "1.23.5",
  "name": "LightTab - Minimal New Tab",
  "short_name": "LightTab",
  "description": "Minimal new tab: clock, lunar calendar, search, AI prompts, shortcuts, to-dos, Bing wallpapers. Local-first, optional cloud sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "optional_permissions": [
    "bookmarks",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*.icloud.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.outlook.com/*",
    "https://*.office.com/*",
    "https://*.live.com/*",
    "https://*.calendar.yahoo.com/*",
    "https://*.fastmail.com/*",
    "https://*.nextcloud.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://movie.douban.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/chat*",
        "https://www.dola.com/chat*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "js/inject-ai.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "commands": {
    "open-ai": {
      "description": "Open LightTab AI assistant"
    }
  }
}
