{
  "manifest_version": 3,
  "version": "1.18.1",
  "name": "LightTab - Minimal New Tab",
  "short_name": "LightTab",
  "description": "Minimal new tab: clock, lunar calendar, search, AI prompts, shortcuts, to-dos, Bing wallpapers. Local-first, optional cloud sync.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/chat*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "js/inject-ai.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}